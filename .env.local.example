# POS local app -> Appwrite self-hosted
#
# Copy this file to .env.local and set APPWRITE_API_KEY.
# Do not commit .env.local.

APPWRITE_PROJECT_ID=6a3edc1b003419265462
APPWRITE_PROJECT_NAME=pos
APPWRITE_ENDPOINT=https://agencia-appwrite.n2wanx.easypanel.host/v1
APPWRITE_API_KEY=replace_with_server_side_api_key
APPWRITE_DATABASE_ID=pos_db
SESSION_COOKIE_NAME=a_session_6a3edc1b003419265462

NEXT_PUBLIC_APPWRITE_ENDPOINT=https://agencia-appwrite.n2wanx.easypanel.host/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=6a3edc1b003419265462
NEXT_PUBLIC_APPWRITE_DATABASE_ID=pos_db
NEXT_PUBLIC_COL_USER_PROFILES=user_profiles
NEXT_PUBLIC_COL_BRANCHES=branches
NEXT_PUBLIC_COL_BRANCH_PAYMENT_METHODS=branch_payment_methods
COL_INSTITUTE_API_SETTINGS=institute_api_settings
NEXT_PUBLIC_COL_CATEGORIES=categories
NEXT_PUBLIC_COL_PRODUCTS=products
NEXT_PUBLIC_COL_STOCK=stock
NEXT_PUBLIC_COL_STOCK_MOVEMENTS=stock_movements
NEXT_PUBLIC_COL_INVENTORY_GRANTS=inventory_grants
NEXT_PUBLIC_COL_SALES=sales
NEXT_PUBLIC_COL_SALE_ITEMS=sale_items
COL_PAYMENT_LINKS=payment_links
COL_AUDIT_EVENTS=audit_events
COL_POS_UI_SETTINGS=pos_ui_settings
NEXT_PUBLIC_APPWRITE_STORAGE_BUCKET=pos_images

# Used to encrypt provider credentials stored from the admin UI.
# If empty, the server falls back to APPWRITE_API_KEY as encryption material.
PAYMENT_CREDENTIALS_SECRET=replace_with_long_random_secret

# QR Simple Baneco base URLs. Credentials are configured per branch from /pagos.
BANECO_QR_CERTIFICATION_BASE_URL=https://apimktdesa.baneco.com.bo/ApiGateway
BANECO_QR_PRODUCTION_BASE_URL=https://apimkt.baneco.com.bo/ApiGateway
# Compatibilidad con instalaciones antiguas. Configura la conexión desde la UI.
INSTITUTE_PAYMENTS_API_BASE_URL=
INSTITUTE_PAYMENTS_API_TOKEN=
